[worldserver]

########################################
# HttpApi module configuration
########################################
#
#    HttpApi.Enable
#        Description: Enable the HTTP API server
#        Default:     1 - Enabled
#                      0 - Disabled
#
#    HttpApi.Port
#        Description: Port the HTTP API server listens on
#        Default:     8080
#
#    HttpApi.BindAddress
#        Description: IP address to bind the HTTP API server to
#        Default:     0.0.0.0 (all interfaces)
#

HttpApi.Enable = 1
HttpApi.Port = 8080
HttpApi.BindAddress = 0.0.0.0
